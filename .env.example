# Values used by containers. `./scripts/local.sh start` replaces the Supabase
# key in .env.runtime with the key reported by the local Supabase CLI.
API_BASE_URL=http://api:8000
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=populated-by-local-wrapper

# Local-only authenticated smoke path. Replace these when copying to .env.
ENABLE_SMOKE_ENDPOINTS=true
SMOKE_TEST_TOKEN=replace-with-a-local-random-value
SMOKE_AUTH_EMAIL=runtime-smoke@localhost.invalid
SMOKE_AUTH_PASSWORD=replace-with-a-local-password-of-at-least-12-characters

# Local-only WI-002 identities. Use distinct passwords with at least 12 characters,
# lowercase and uppercase letters, and digits. Never reuse production credentials.
DEMO_OPERATOR_EMAIL=operator@localhost.invalid
DEMO_OPERATOR_PASSWORD=replace-with-a-local-operator-password
DEMO_SUPERVISOR_EMAIL=supervisor@localhost.invalid
DEMO_SUPERVISOR_PASSWORD=replace-with-a-local-supervisor-password
DEMO_ANALYST_EMAIL=analyst@localhost.invalid
DEMO_ANALYST_PASSWORD=replace-with-a-local-analyst-password

# n8n is local-only in WI-001.
N8N_ENCRYPTION_KEY=replace-with-a-local-random-value

# AI provider config
AI_PROVIDER=provider
OPENAI_API_KEY=replace-with-a-local-openai-key
OPENAI_MODEL=any-model