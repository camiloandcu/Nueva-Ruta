# Values used by containers. `./scripts/local.sh start` replaces the Supabase
# key in .env.runtime with the key reported by the local Supabase CLI.
API_BASE_URL=http://api:8000
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=populated-by-local-wrapper

# Local-only authenticated smoke path. Replace these when copying to .env.
ENABLE_SMOKE_ENDPOINTS=true
SMOKE_TEST_TOKEN=replace-with-a-local-random-value
SMOKE_AUTH_EMAIL=runtime-smoke@localhost.invalid
SMOKE_AUTH_PASSWORD=replace-with-a-local-password-of-at-least-12-characters

# n8n is local-only in WI-001.
N8N_ENCRYPTION_KEY=replace-with-a-local-random-value

