{
  "id": "a0090000-0000-4000-8000-000000000105",
  "name": "WI-005 Partner Transfer and Recovery",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "wi-005-partner-transfer", "responseMode": "responseNode"},
      "id": "transfer-webhook",
      "name": "Approved transfer dispatch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rules": {"values": [
          {"conditions": {"conditions": [{"leftValue": "={{$json.operation}}", "rightValue": "replay", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "manual_replay"}
        ]},
        "options": {"fallbackOutput": "extra", "renameFallbackOutput": "process_due_transfers"}
      },
      "id": "delivery-operation",
      "name": "Delivery operation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [240, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_INTERNAL_URL}}/v1/crm/deliveries/process",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{$json.auth_token}}"}, {"name": "X-Correlation-ID", "value": "={{'wi005-delivery-' + $execution.id}}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({mode: $json.mode || 'success'})}}",
        "options": {"response": {"response": {"neverError": true}}}
      },
      "id": "fastapi-dispatch",
      "name": "FastAPI outbox boundary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_INTERNAL_URL}}/v1/crm/deliveries/{{$json.event_id}}/replay",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{$json.auth_token}}"}, {"name": "X-Correlation-ID", "value": "={{$json.correlation_id}}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({reason: $json.reason, correlation_id: $json.correlation_id})}}",
        "options": {"response": {"response": {"neverError": true}}}
      },
      "id": "fastapi-replay",
      "name": "FastAPI replay boundary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "rules": {"values": [
          {"conditions": {"conditions": [{"leftValue": "={{$json.status}}", "rightValue": "pending", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "replay_queued"}
        ]},
        "options": {"fallbackOutput": "extra", "renameFallbackOutput": "replay_refused_or_api_error"}
      },
      "id": "replay-outcome",
      "name": "Replay result",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "rules": {"values": [
          {"conditions": {"conditions": [{"leftValue": "={{$json.results[0].status}}", "rightValue": "delivered", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "partner_accepted"},
          {"conditions": {"conditions": [{"leftValue": "={{$json.results[0].status}}", "rightValue": "retry_scheduled", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "retry_scheduled"},
          {"conditions": {"conditions": [{"leftValue": "={{$json.results[0].status}}", "rightValue": "dead_letter", "operator": {"type": "string", "operation": "equals"}}]}, "renameOutput": true, "outputKey": "dead_letter_recovery"}
        ]},
        "options": {"fallbackOutput": "extra", "renameFallbackOutput": "no_due_work_or_api_error"}
      },
      "id": "delivery-outcome",
      "name": "Delivery outcome",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [520, 0]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{$json}}"},
      "id": "return-result",
      "name": "Return delivery evidence",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [800, 0]
    }
  ],
  "connections": {
    "Approved transfer dispatch": {"main": [[{"node": "Delivery operation", "type": "main", "index": 0}]]},
    "Delivery operation": {"main": [[{"node": "FastAPI replay boundary", "type": "main", "index": 0}], [{"node": "FastAPI outbox boundary", "type": "main", "index": 0}]]},
    "FastAPI replay boundary": {"main": [[{"node": "Replay result", "type": "main", "index": 0}]]},
    "Replay result": {"main": [[{"node": "Return delivery evidence", "type": "main", "index": 0}], [{"node": "Return delivery evidence", "type": "main", "index": 0}]]},
    "FastAPI outbox boundary": {"main": [[{"node": "Delivery outcome", "type": "main", "index": 0}]]},
    "Delivery outcome": {"main": [[{"node": "Return delivery evidence", "type": "main", "index": 0}], [{"node": "Return delivery evidence", "type": "main", "index": 0}], [{"node": "Return delivery evidence", "type": "main", "index": 0}], [{"node": "Return delivery evidence", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "active": false,
  "versionId": "00000000-0000-4000-8000-000000000005",
  "meta": {"templateCredsSetupCompleted": false}
}
